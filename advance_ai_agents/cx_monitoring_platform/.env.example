# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Database Configuration
DATABASE_URL=sqlite:///./sla_library.db
# For PostgreSQL: postgresql://user:password@localhost:5432/cx_monitoring

# Redis Configuration (optional - for caching and real-time monitoring)
REDIS_URL=redis://localhost:6379/0

# OpenAI API Key (for AI-powered SLA analysis and recommendations)
OPENAI_API_KEY=your_openai_api_key_here

# Logging
LOG_LEVEL=INFO

# Alert Configuration
ALERT_EMAIL_ENABLED=false
ALERT_WEBHOOK_ENABLED=false
ALERT_WEBHOOK_URL=https://your-webhook-url.com/alerts

# Monitoring Thresholds
DEFAULT_SEVERITY_CRITICAL=95
DEFAULT_SEVERITY_MAJOR=85
DEFAULT_SEVERITY_MINOR=75
